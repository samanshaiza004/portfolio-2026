---
import Layout from '../layouts/Layout.astro';
import PanelWatermark from '../components/PanelWatermark.astro';
import { statusItems } from '../data/status';

const favorites = [
  { k: 'game', v: 'the entirety of the ace attorney franchise' },
  { k: 'music', v: 'Vylet Pony, Porter Robinson, and myspacemark' },
  { k: 'drink', v: 'black coffee' },
  { k: 'color', v: 'green' },
  { k: 'animal', v: 'cats i guess? 🐱' },
];
---

<Layout title="about" description="a little about saman — software, music, card games, and cats.">
  <div class="glass about-panel">
    <PanelWatermark />
    <section class="about-intro" data-animate>
      <h1 class="about-title">about</h1>
      <p>
        my name is saman and i like programming sometimes. I created samanshaiza.com to share my work,
        interests, and other things going on in my life.
      </p>
      <p>
        Beyond programming, i enjoy making music and doing other creative things like drawing,
        reading, or sharing cool things through blogs and technical writing.
      </p>
    </section>

    <div class="etch"></div>

    <section class="about-faves" data-animate>
      <h2 class="about-faves-heading">★ my favorite things</h2>
      <dl class="faves-table">
        {
          favorites.map((f) => (
            <div class="faves-row">
              <dt>{f.k}</dt>
              <dd>{f.v}</dd>
            </div>
          ))
        }
      </dl>
    </section>
   
  </div>
</Layout>

<style>
  .about-panel { padding: 0; }

  .about-intro { position: relative; z-index: 1; padding: 38px 38px 28px; }
  .about-title { font-family: var(--font-display); font-size: 46px; font-weight: 700; line-height: 1.02; letter-spacing: -0.02em; color: #221f1b; margin-bottom: 16px; }
  .about-intro p { font-size: 16px; line-height: 1.65; color: #4a443c; max-width: 560px; }
  .about-intro p + p { margin-top: 14px; }

  .about-status { position: relative; z-index: 1; padding: 24px 38px 28px; }
  .about-status-heading { font-family: var(--font-display); font-size: 24px; font-weight: 700; color: var(--accent); margin-bottom: 14px; }
  .status-list { list-style: none; padding: 0; margin: 0; display: flex; flex-direction: column; gap: 10px; }
  .status-row { display: flex; align-items: center; gap: 10px; font-size: 15px; }
  .status-icon-wrap { display: flex; align-items: center; flex-shrink: 0; width: 36px; height: 32px; }
  .status-icon { max-width: 36px; max-height: 32px; width: auto; height: auto; object-fit: contain; }
  .status-label { font-family: var(--font-display); font-weight: 700; color: var(--accent); white-space: nowrap; }
  .status-value { color: #4a443c; }
  .status-updated { font-size: 12px; color: #9a9388; margin-top: 14px; }

  .about-misc { position: relative; z-index: 1; padding: 24px 38px 36px; }
  .about-misc p { font-size: 15px; line-height: 1.7; color: #4a443c; max-width: 540px; }
  .about-misc p + p { margin-top: 12px; }
  .about-misc em { font-style: italic; color: #262320; }

  .about-faves { position: relative; z-index: 1; padding: 24px 38px 32px; }
  .about-faves-heading { font-family: var(--font-display); font-size: 24px; font-weight: 700; color: var(--accent); margin-bottom: 14px; }

  .faves-table { display: flex; flex-direction: column; border-radius: 12px; overflow: hidden; border: 1px solid rgba(150,138,118,0.2); }
  .faves-row { display: grid; grid-template-columns: 120px 1fr; gap: 12px; padding: 10px 14px; align-items: baseline; }
  .faves-row:nth-child(odd) { background: rgba(255,255,255,0.4); }
  .faves-row dt { font-family: var(--font-display); font-weight: 700; font-size: 15px; color: var(--accent); }
  .faves-row dd { font-size: 15px; color: #4a443c; }

  @media (max-width: 520px) {
    .about-intro { padding: 28px 22px 22px; }
    .about-title { font-size: 36px; }
    .about-status { padding: 20px 22px 24px; }
    .about-faves { padding: 20px 22px 26px; }
    .faves-row { grid-template-columns: 90px 1fr; }
  }
</style>
