---
import Layout from '../layouts/Layout.astro';
import { getCollection } from 'astro:content';

const posts = (await getCollection('blog', ({ data }) => !data.draft)).sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf(),
);
const recent = posts.slice(0, 3);
const fmt = (d: Date) =>
  d.toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' });
---

<Layout>
  <section class="glass p-6">
    <h1 class="text-5xl font-bold tracking-tight sm:text-6xl">welcome to saman!</h1>
    <p class="mt-2 text-xl text-muted-foreground">pronounced suh-mon</p>

    <p class="mt-6 max-w-prose text-muted-foreground">
      my personal website where i like to share my work, interests, and whatever
      else i can think of ^_^
    </p>

    <hr class="my-6 border-border/40" />

    <h2 class="text-brand-green flex items-center gap-2 text-lg font-bold">
      recent posts
    </h2>
    <ul class="mt-3 space-y-3">
      {
        recent.map((post) => (
          <li>
            <a href={`/blog/${post.id}/`} class="group block">
              <span class="text-xs text-muted-foreground">{fmt(post.data.date)}</span>
              <span class="block font-bold group-hover:underline">{post.data.title}</span>
              <span class="block text-sm text-muted-foreground">{post.data.description}</span>
            </a>
          </li>
        ))
      }
    </ul>
    <a href="/blog/" class="mt-4 inline-block text-sm underline underline-offset-2">
      all posts →
    </a>
  </section>
</Layout>
