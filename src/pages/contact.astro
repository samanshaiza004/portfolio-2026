---
import Layout from '../layouts/Layout.astro';

// Public handles only. The 2024 page also listed a phone number — deliberately
// dropped (the brief flagged it as leaked personal info; do not carry it over).
const contacts = [
  { label: 'email',    value: 'samanshaiza@yahoo.com',        href: 'mailto:samanshaiza@yahoo.com' },
  { label: 'github',   value: 'github.com/samanshaiza004',    href: 'https://github.com/samanshaiza004' },
  { label: 'linkedin', value: 'linkedin.com/in/samanshaiza',  href: 'https://linkedin.com/in/samanshaiza' },
  { label: 'discord',  value: 'samanshaiza',                  href: null },
];
const isExternal = (href: string | null) => !!href && href.startsWith('http');
---

<Layout title="contact" description="get in touch with saman — email, github, linkedin, discord.">
  <div class="glass contact-panel">
    <section class="contact-head" data-animate>
      <h1 class="contact-title">Let’s talk.</h1>
      <p class="contact-sub">For projects, software questions, music links, or a good internet rabbit hole. Email is the fastest route.</p>
    </section>

    <div class="etch"></div>

    <section class="contact-body" data-animate>
      <ul class="contact-grid">
        {
          contacts.map((c) => {
            const inner = (
              <>
                <span class="label">{c.label}</span>
                <span class="contact-value">{c.value}</span>
              </>
            );
            return (
              <li>
                {c.href ? (
                  <a
                    class="contact-card scrow"
                    href={c.href}
                    {...(isExternal(c.href) ? { target: '_blank', rel: 'noopener noreferrer' } : {})}
                  >
                    {inner}
                  </a>
                ) : (
                  <div class="contact-card scrow">{inner}</div>
                )}
              </li>
            );
          })
        }
      </ul>
      <p class="contact-foot">just a direct line. ♡</p>
    </section>
  </div>
</Layout>

<style>
  .contact-panel { padding: 0; }

  .contact-head { position: relative; z-index: 1; padding: 38px 40px 28px; }
  .contact-kicker { font-size: 11px; font-weight: 750; letter-spacing: .13em; text-transform: uppercase; color: var(--accent); margin-bottom: 10px; }
  .contact-title { font-family: var(--font-display); font-size: 56px; font-weight: 780; line-height: .95; letter-spacing: -0.055em; color: var(--ink); }
  .contact-sub { max-width: 540px; font-size: 16px; line-height: 1.6; color: #5a5f58; margin-top: 16px; }

  .contact-body { position: relative; z-index: 1; padding: 24px 40px 32px; }
  .contact-grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 12px; list-style: none; margin: 0; padding: 0; }
  .contact-card { display: flex; flex-direction: column; align-items: flex-start; gap: 4px; padding: 14px 16px; border-radius: 5px; }
  a.contact-card { transition: border-color 0.15s, transform 0.15s; }
  a.contact-card:hover { border-color: var(--accent); transform: translateY(-1px); }
  .contact-value { font-size: 15px; font-weight: 600; color: #2f2b26; word-break: break-word; }

  .contact-foot { margin-top: 20px; font-size: 14.5px; color: #6a6359; }

  @media (max-width: 560px) {
    .contact-head { padding: 28px 22px 20px; }
    .contact-title { font-size: 44px; }
    .contact-body { padding: 20px 22px 26px; }
    .contact-grid { grid-template-columns: 1fr; }
  }
</style>
