---
import Layout from '../../layouts/Layout.astro';
import { getCollection } from 'astro:content';

const posts = (await getCollection('blog', ({ data }) => !data.draft)).sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf(),
);
const fmt = (d: Date) =>
  d.toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric', timeZone: 'UTC' });
---

<Layout title="blog" description="posts on code, tools, and whatever else.">
  <div class="glass blog-panel">
    <section class="blog-body">
      <header class="blog-head" data-animate>
        <h1 class="blog-title">blog</h1>
      </header>
      {
        posts.map((post, i) => (
          <>
            {i > 0 && <div class="etch" style="opacity:0.6"></div>}
            <a class="post-row" href={`/blog/${post.id}/`} data-animate>
              <div class="post-date">{fmt(post.data.date)}</div>
              <div class="post-title">{post.data.title}</div>
              <div class="post-blurb">{post.data.description}</div>
              <div class="post-tags">
                {post.data.tags.map((tag) => <span class="tag">{tag}</span>)}
              </div>
            </a>
          </>
        ))
      }
    </section>
  </div>
</Layout>

<style>
  .blog-panel { padding: 0; }
  .blog-body { position: relative; z-index: 1; padding: 36px 40px 30px; }
  .blog-head { margin-bottom: 12px; }
  .blog-head p { font-size: 11px; font-weight: 750; letter-spacing: .13em; text-transform: uppercase; color: var(--accent); margin-bottom: 9px; }
  .blog-title { max-width: 560px; font-family: var(--font-display); font-size: 48px; line-height: .95; font-weight: 780; letter-spacing: -0.05em; color: var(--ink); }
  .post-date { font-size: 12.5px; color: #8a8377; }
  .post-blurb { font-size: 14.5px; line-height: 1.55; color: #6a6359; }
  .post-tags { display: flex; flex-wrap: wrap; gap: 6px; margin-top: 8px; }
  .tag {
    font-size: 11px; font-weight: 700; letter-spacing: 0.06em;
    color: var(--accent); background: rgba(23,138,85,0.1);
    border: 1px solid rgba(23,138,85,0.2); border-radius: 999px; padding: 3px 10px;
  }

  @media (max-width: 560px) {
    .blog-body { padding: 24px 22px 24px; }
    .blog-title { font-size: 39px; }
  }
</style>
