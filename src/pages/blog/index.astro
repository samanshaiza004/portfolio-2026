---
import Layout from '../../layouts/Layout.astro';
import { getCollection } from 'astro:content';

const posts = (await getCollection('blog', ({ data }) => !data.draft)).sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf(),
);
const fmt = (d: Date) =>
  d.toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' });
---

<Layout title="blog" description="posts on code, tools, and whatever else.">
  <h1 class="mb-6 text-4xl font-bold">blog</h1>
  <ul class="glass divide-y divide-border">
    {
      posts.map((post) => (
        <li class="p-4">
          <a href={`/blog/${post.id}/`} class="group block">
            <span class="text-xs text-muted-foreground">{fmt(post.data.date)}</span>
            <h2 class="text-lg font-bold group-hover:underline">{post.data.title}</h2>
            <p class="mt-1 text-sm text-muted-foreground">{post.data.description}</p>
            <div class="mt-2 flex flex-wrap gap-1.5">
              {post.data.tags.map((tag) => (
                <span class="rounded-full bg-secondary px-2.5 py-0.5 text-xs text-secondary-foreground">
                  {tag}
                </span>
              ))}
            </div>
          </a>
        </li>
      ))
    }
  </ul>
</Layout>
