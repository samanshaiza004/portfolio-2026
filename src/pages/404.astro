---
import Layout from '../layouts/Layout.astro';
---

<Layout title="404 — not found" description="this page wandered off somewhere.">
  <div class="glass error-panel" data-animate>
    <img class="error-gif" src="/icons/nav-home.gif" alt="an epic horse neighing" width="64" height="44" />
    <h1 class="error-code">404</h1>
    <p class="error-lead">this page wandered off.</p>
    <p class="error-sub">
      the link you followed is broken, or the page never existed in the first
      place. it happens — the web is a big, weird place. ^_^
    </p>
    <a class="green-pill" href="/"><span>← take me home</span></a>
  </div>
</Layout>

<style>
  .error-panel {
    position: relative; z-index: 1;
    padding: 56px 38px 48px;
    text-align: center;
    display: flex; flex-direction: column; align-items: center;
  }
  .error-gif { width: 64px; height: 44px; object-fit: contain; margin-bottom: 8px; }
  .error-code {
    font-family: var(--font-display); font-weight: 700; font-size: 88px; line-height: 1;
    letter-spacing: -0.03em; color: #221f1b;
  }
  .error-lead { font-family: var(--font-display); font-size: 22px; color: var(--accent); margin-top: 6px; }
  .error-sub { font-size: 15px; line-height: 1.6; color: #6a6359; max-width: 440px; margin: 12px 0 26px; }

  @media (max-width: 520px) {
    .error-panel { padding: 40px 22px 36px; }
    .error-code { font-size: 64px; }
  }
</style>
