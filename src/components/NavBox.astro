---
import { Image } from 'astro:assets';
import logoSrc from '../assets/logo.jpg';
import { statusItems, statusUpdated } from '../data/status';

const path = Astro.url.pathname;
const isActive = (href: string) =>
  href === '/' ? path === '/' : path.startsWith(href);

const nav = [
  { name: 'home',    href: '/',        icon: '/icons/nav-home.gif',    alt: 'an epic horse neighing' },
  { name: 'about',   href: '/about',   icon: '/icons/nav-about.gif',   alt: 'a revolver revolving' },
  { name: 'blog',    href: '/blog',    icon: '/icons/nav-blog.gif',    alt: 'a book opening' },
  { name: 'contact', href: '/contact', icon: '/icons/nav-contact.gif', alt: 'a sony cat' },
];

const SC = 'https://w.soundcloud.com/player/?url=https%3A//api.soundcloud.com/tracks/soundcloud%253Atracks%253A';
const SC_OPTS = '&color=%23178a55&auto_play=false&hide_related=true&show_comments=false&show_user=true&show_reposts=false&show_teaser=false&visual=false';
const tunes = [
  {
    track: 'Duro', artist: 'Skrillex & Young Miko',
    embed: `${SC}2294198822${SC_OPTS}`,
    trackUrl: 'https://soundcloud.com/skrillex/durowyoungmiko',
    artistUrl: 'https://soundcloud.com/skrillex',
  },
  {
    track: '80HD', artist: 'pocket',
    embed: `${SC}1548004483${SC_OPTS}`,
    trackUrl: 'https://soundcloud.com/songsbypocket/80hd-1',
    artistUrl: 'https://soundcloud.com/songsbypocket',
  },
  {
    track: 'Throw Away', artist: 'syzy',
    embed: `${SC}2281231562${SC_OPTS}`,
    trackUrl: 'https://soundcloud.com/syzymusic2/throw-away',
    artistUrl: 'https://soundcloud.com/syzymusic2',
  },
];
---

<aside class="navbox glass" transition:persist="navbox">
  <div class="nb-section nb-identity">
    <div class="nb-avatar"><Image src={logoSrc} alt="samanshaiza logo" width="44" height="44" /></div>
    <div class="nb-identity-text">
      <div class="nb-name">samanshaiza</div>
      <div class="nb-doing" aria-label="what saman is doing right now">
        {
          statusItems.map((s, i) => (
            <span class:list={["nb-doing-item", { 'is-active': i === 0 }]}>
              <span class="nb-doing-label">{s.label}:</span> <span class="nb-doing-value">{s.value}</span>
            </span>
          ))
        }
        
      </div>
            <p class="status-updated">last updated: {statusUpdated}</p>
    </div>
  </div>
  <div class="etch"></div>

  <nav class="nb-section nb-nav" aria-label="Primary">
    {/* Bookmark-style tab that slides to the active link on navigation
        (animated with anime.js). The instant background on the active
        .navlink itself is the no-JS/first-paint fallback — this tab is a
        purely additive enhancement, never the only indicator. */}
    <span class="nb-nav-tab" aria-hidden="true"></span>
    {
      nav.map((n) => (
        <a
          class="navlink"
          href={n.href}
          aria-current={isActive(n.href) ? 'page' : undefined}
        >
          <picture aria-hidden="true">
            <source media="(prefers-reduced-motion: reduce)" srcset={n.icon.replace('.gif', '-static.png')} />
            <img class="nav-gif" src={n.icon} alt="" width="24" height="20" loading="lazy" />
          </picture>
          <span>{n.name}</span>
        </a>
      ))
    }
  </nav>
  <div class="etch"></div>

  {/* fav tunes — players load on demand so three third-party embeds do not
      dominate the initial page cost. Once loaded, transition:persist keeps them. */}
  <div class="nb-section">
    {/* heading doubles as a hover/focus tooltip trigger (ported from the 2024
        HoverCard) — cursor stays the default arrow, like the original. */}
    <div class="nb-tunes-hc">
      <p class="nb-heading nb-tunes-trigger" tabindex="0" aria-describedby="nb-tunes-tip">♪ my fav tunes rn</p>
      <span class="nb-tunes-tip" id="nb-tunes-tip" role="tooltip">you can keep listening while you explore ♡</span>
    </div>
    <div class="nb-tunes">
      {
        tunes.map((t) => (
          <div class="nb-tune">
            <iframe
              class="nb-sc"
              title={`SoundCloud — ${t.track} by ${t.artist}`}
              width="100%"
              height="120"
              scrolling="no"
              frameborder="0"
              loading="lazy"
              allow="autoplay"
              src={t.embed}
            />
            <div class="nb-tune-links">
              <a href={t.artistUrl} target="_blank" rel="noopener noreferrer">{t.artist}</a>
              <span aria-hidden="true"> · </span>
              <a href={t.trackUrl} target="_blank" rel="noopener noreferrer">{t.track}</a>
            </div>
          </div>
        ))
      }
    </div>
  </div>
  <div class="etch"></div>

  {/* date / clock / weather — Open-Meteo (keyless), Frisco TX, updated every 30 min */}
  <div class="nb-section nb-weather">
    <div class="nb-date" data-clock-date>—</div>
    <div class="nb-time" data-clock-time>—</div>
    <div class="nb-weather-row">
      <div>
        <div class="nb-loc">Frisco, TX</div>
        <div class="nb-temp" data-weather-temp>—°F</div>
        <div class="nb-cond" data-weather-cond>—</div>
      </div>
      <div class="nb-sun" data-weather-icon>☀</div>
    </div>
  </div>
</aside>

<script>
  import { animate } from 'animejs';

  // The NavBox uses transition:persist — its DOM node survives navigations, so
  // this runs ONCE per session (guarded), even though the hoisted script
  // re-executes on each view-transition swap.
  if (!(window as any).__navboxInit) {
    (window as any).__navboxInit = true;

    // Live clock. Queries the live nodes each tick (they persist) and ticks
    // every second — never resets to the "—" placeholder on navigation.
    const tick = () => {
      const now = new Date();
      const dateEl = document.querySelector('[data-clock-date]');
      const timeEl = document.querySelector('[data-clock-time]');
      if (dateEl) {
        dateEl.textContent = now.toLocaleDateString('en-US', {
          weekday: 'long', year: 'numeric', month: 'long', day: 'numeric',
        });
      }
      if (timeEl) {
        timeEl.textContent = now.toLocaleTimeString('en-US', {
          hour: 'numeric', minute: '2-digit',
        });
      }
    };
    tick();
    setInterval(tick, 1000);

    // Live weather — Open-Meteo (keyless, CORS-friendly), Frisco TX, °F. Replaces
    // the 2024 client fetch that leaked an OpenWeather key; no key, no server.
    // Maps WMO weather codes to a label + glyph; fails silently (placeholders stay).
    const wmo = (c: number): { icon: string; text: string } => {
      if (c === 0) return { icon: '☀', text: 'clear sky' };
      if (c === 1) return { icon: '🌤', text: 'mainly clear' };
      if (c === 2) return { icon: '⛅', text: 'partly cloudy' };
      if (c === 3) return { icon: '☁', text: 'overcast' };
      if (c === 45 || c === 48) return { icon: '🌫', text: 'fog' };
      if (c >= 51 && c <= 57) return { icon: '🌦', text: 'drizzle' };
      if (c >= 61 && c <= 67) return { icon: '🌧', text: 'rain' };
      if (c >= 71 && c <= 77) return { icon: '🌨', text: 'snow' };
      if (c >= 80 && c <= 82) return { icon: '🌦', text: 'rain showers' };
      if (c >= 85 && c <= 86) return { icon: '🌨', text: 'snow showers' };
      if (c >= 95) return { icon: '⛈', text: 'thunderstorm' };
      return { icon: '☁', text: 'cloudy' };
    };
    const loadWeather = async () => {
      try {
        const res = await fetch(
          'https://api.open-meteo.com/v1/forecast?latitude=33.1507&longitude=-96.8236' +
          '&current=temperature_2m,weather_code&temperature_unit=fahrenheit&timezone=America/Chicago',
        );
        if (!res.ok) return;
        const cur = (await res.json())?.current;
        if (!cur || typeof cur.temperature_2m !== 'number') return;
        const { icon, text } = wmo(cur.weather_code);
        const tempEl = document.querySelector('[data-weather-temp]');
        const condEl = document.querySelector('[data-weather-cond]');
        const iconEl = document.querySelector('[data-weather-icon]');
        if (tempEl) tempEl.textContent = `${Math.round(cur.temperature_2m)}°F`;
        if (condEl) condEl.textContent = text;
        if (iconEl) iconEl.textContent = `${icon} ${text.split(' ')[0]}`;
      } catch {
        /* offline / blocked — leave the "—" placeholders, never a broken card */
      }
    };
    loadWeather();
    setInterval(loadWeather, 1_800_000); // refresh every 30 min (matches 2024)

    // Active nav highlight. The persisted node keeps its server-rendered
    // aria-current, so we re-derive it from the URL after every swap.
    const updateActiveNav = () => {
      const path = location.pathname;
      document.querySelectorAll<HTMLAnchorElement>('.navbox .navlink').forEach((a) => {
        const href = a.getAttribute('href') || '';
        const active = href === '/' ? path === '/' : path.startsWith(href);
        if (active) a.setAttribute('aria-current', 'page');
        else a.removeAttribute('aria-current');
      });
    };

    // Bookmark tab that slides to whichever link is active. Instant on first
    // load (nothing to slide FROM yet); animated with anime.js on navigation,
    // so the current page has a small, tactile payoff instead of a noisy flash.
    const navReduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    let navTabAnimation: ReturnType<typeof animate> | null = null;
    const moveNavTab = (instant = false) => {
      const navEl = document.querySelector<HTMLElement>('.nb-nav');
      const tab = document.querySelector<HTMLElement>('.nb-nav-tab');
      const active = navEl?.querySelector<HTMLAnchorElement>('.navlink[aria-current="page"]');
      if (!navEl || !tab || !active) return;
      const navRect = navEl.getBoundingClientRect();
      const activeRect = active.getBoundingClientRect();
      const top = activeRect.top - navRect.top - 6;
      const height = Math.max(22, activeRect.height - 16);
      if (instant || navReduceMotion) {
        navTabAnimation?.pause();
        tab.style.transform = `translateY(${top}px)`;
        tab.style.height = `${height}px`;
        tab.classList.add('is-ready');
        return;
      }
      tab.classList.add('is-ready');
      navTabAnimation?.pause();
      navTabAnimation = animate(tab, {
        translateY: top,
        height,
        scaleX: [0.78, 1],
        duration: 520,
        ease: 'outBack(1.35)',
      });
    };

    updateActiveNav();
    moveNavTab(true);
    document.fonts?.ready.then(() => moveNavTab(true));

    // Move the marker as soon as a link is chosen. The after-swap pass below
    // remains the source of truth once Astro has mounted the next page.
    document.querySelectorAll<HTMLAnchorElement>('.navbox .navlink').forEach((link) => {
      link.addEventListener('click', () => {
        const href = link.getAttribute('href') || '';
        const currentPath = location.pathname;
        const isSamePage = href === '/' ? currentPath === '/' : currentPath.startsWith(href);
        if (isSamePage) return;
        document.querySelectorAll<HTMLAnchorElement>('.navbox .navlink').forEach((item) => {
          if (item === link) item.setAttribute('aria-current', 'page');
          else item.removeAttribute('aria-current');
        });
        moveNavTab();
      });
    });
    document.addEventListener('astro:after-swap', () => {
      updateActiveNav();
      requestAnimationFrame(() => moveNavTab());
    });
    let resizeFrame = 0;
    window.addEventListener('resize', () => {
      cancelAnimationFrame(resizeFrame);
      resizeFrame = requestAnimationFrame(() => moveNavTab(true));
    }, { passive: true });

    // Third-party audio is opt-in. This preserves the playful sidebar while
    // keeping SoundCloud's scripts and artwork off the critical path.
    document.querySelectorAll<HTMLButtonElement>('[data-sc-src]').forEach((button) => {
      button.addEventListener('click', () => {
        const src = button.dataset.scSrc;
        if (!src) return;
        const iframe = document.createElement('iframe');
        iframe.className = 'nb-sc';
        iframe.title = button.dataset.scTitle || 'SoundCloud player';
        iframe.width = '100%';
        iframe.height = '120';
        iframe.scrolling = 'no';
        iframe.frameBorder = '0';
        iframe.allow = 'autoplay';
        iframe.src = src;
        button.replaceWith(iframe);
      }, { once: true });
    });

    // "what i'm doing rn" carousel — cross-fade through the status items under
    // the name. Auto-rotates only when motion is allowed; pauses on hover/focus
    // so there's always a way to stop the auto-updating content (a11y).
    const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    const doing = document.querySelector('.nb-doing');
    const items = doing
      ? Array.from(doing.querySelectorAll<HTMLElement>('.nb-doing-item'))
      : [];
    if (doing && items.length > 1 && !reduceMotion) {
      let idx = 0;
      let timer: ReturnType<typeof setInterval> | null = null;
      const rotate = () => {
        items[idx].classList.remove('is-active');
        idx = (idx + 1) % items.length;
        items[idx].classList.add('is-active');
      };
      const start = () => { if (!timer) timer = setInterval(rotate, 3400); };
      const stop = () => { if (timer) { clearInterval(timer); timer = null; } };
      start();
      doing.addEventListener('mouseenter', stop);
      doing.addEventListener('mouseleave', start);
      doing.addEventListener('focusin', stop);
      doing.addEventListener('focusout', start);
    }
  }
</script>

<style>
  .navbox { padding: 0; position: sticky; top: 42px; }
  /* Stacked below content on mobile — don't pin the tall sidebar to the top. */
  @media (max-width: 900px) { .navbox { position: static; } }
  .nb-section { position: relative; z-index: 1; }
  .nb-identity { padding: 22px 20px 18px; display: flex; align-items: center; gap: 12px; }
  /* Logo avatar — the round mask hides the source JPG's dark corners; the inner
     image is zoomed past the frame (overflow-clipped) to crop the silvery
     vignette so only the glossy mark shows. */
  .nb-avatar {
    position: relative; width: 44px; height: 44px; flex-shrink: 0;
    border-radius: 50%; overflow: hidden; background: #fff;
    border: 1px solid rgba(255,255,255,0.9);
    box-shadow: inset 0 1px 0 rgba(255,255,255,0.6), 0 2px 6px rgba(110,98,78,0.28);
  }
  .nb-avatar img { position: absolute; inset: -12%; width: 124%; height: 124%; object-fit: cover; display: block; }
  .nb-identity-text { min-width: 0; flex: 1; }
  .nb-name { font-family: var(--font-display); font-weight: 780; font-size: 21px; letter-spacing: -0.035em; color: var(--ink); line-height: 1; }

  /* "what i'm doing rn" carousel — items stack and cross-fade (driven by JS) */
  .nb-doing { position: relative; margin-top: 5px; min-height: 2.7em; font-family: var(--font-sans); font-size: 12px; line-height: 1.35; }
  .nb-doing-item {
    position: absolute; inset: 0; opacity: 0;
    transition: opacity 0.55s ease;
    display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden;
  }
  .nb-doing-item.is-active { opacity: 1; }
  .nb-doing-label { color: var(--accent); font-weight: 700; }
  .nb-doing-value { color: #6a6359; }
  @media (prefers-reduced-motion: reduce) {
    .nb-doing-item { transition: none; }
  }

  .nb-nav { position: relative; padding: 14px; display: flex; flex-direction: column; gap: 2px; }
  .nav-gif { width: 24px; height: 20px; object-fit: contain; flex-shrink: 0; image-rendering: auto; }

  /* Bookmark tab — a small green page marker that slides to the active item.
     It is deliberately tactile, not a second full-width active background. */
  .nb-nav-tab {
    z-index: 200;
    position: absolute; left: 7px; width: 7px; border-radius: 999px;
    background: linear-gradient(180deg, #1b8758 0%, var(--accent) 56%, #0e5c3d 100%);
    /* box-shadow:
      inset 1px 0 rgba(255, 255, 255, 0.38),
      0 4px 10px rgba(20, 115, 75, 0.24);
    opacity: 0; pointer-events: none; z-index: 2; */
    transform-origin: center;
    will-change: transform, height, opacity;
    transition: opacity 0.2s ease;
  }
  .nb-nav-tab::before {
    content: "";
    position: absolute; top: 3px; left: 2px; right: 2px; height: 34%;
    border-radius: inherit;
    /* background: rgba(255, 255, 255, 0.34); */
  }
  
  .nb-nav-tab.is-ready { opacity: 1; }

  @media (prefers-reduced-motion: reduce) {
    .nb-nav-tab { transition: none; }
  }

  .nb-heading { font-family: var(--font-display); font-weight: 750; font-size: 15px; color: var(--accent); margin-bottom: 12px; }
  .nb-section:not(.nb-identity):not(.nb-nav):not(.nb-weather) { padding: 16px; }

  /* fav-tunes heading as a hover/focus tooltip trigger (2024 HoverCard port) */
  .nb-tunes-hc { position: relative; display: inline-block; }
  .nb-tunes-trigger {
    margin-bottom: 12px;
    display: inline-flex; align-items: center; gap: 6px;
    cursor: default; user-select: none; -webkit-user-select: none;
    text-decoration: underline dotted transparent; text-underline-offset: 4px;
    transition: color 0.15s ease, text-decoration-color 0.15s ease;
  }
  .nb-tunes-trigger:hover,
  .nb-tunes-trigger:focus-visible {
    color: var(--accent-deep);
    text-decoration-color: rgba(15,111,67,0.55);
    outline: none;
  }
  .nb-tunes-tip {
    position: absolute; top: calc(100% - 4px); left: 0; z-index: 20;
    width: max-content; max-width: 240px;
    font-family: var(--font-sans); font-size: 11.5px; line-height: 1.45; font-weight: 400;
    color: #6a6359;
    background: rgba(255,253,250,0.96);
    border: 1px solid rgba(255,255,255,0.9);
    border-radius: 10px; padding: 8px 11px;
    box-shadow: 0 8px 22px rgba(110,98,78,0.2);
    backdrop-filter: blur(8px); -webkit-backdrop-filter: blur(8px);
    opacity: 0; visibility: hidden; transform: translateY(-4px);
    transition: opacity 0.18s ease, transform 0.18s ease, visibility 0.18s;
    pointer-events: none;
  }
  .status-updated { font-size: 12px; color: #6a6359; }

  .nb-tunes-hc:hover .nb-tunes-tip,
  .nb-tunes-trigger:focus-visible + .nb-tunes-tip {
    opacity: 1; visibility: visible; transform: translateY(0);
  }
  @media (prefers-reduced-motion: reduce) {
    .nb-tunes-trigger, .nb-tunes-tip { transition: none; }
    .nb-tunes-tip { transform: none; }
  }
  .nb-tunes { display: flex; flex-direction: column; gap: 14px; }
  .nb-tune { font-family: var(--font-sans); min-width: 0; }
  .nb-sc { display: block; border-radius: 5px; border: 1px solid rgba(32,35,31,.3); background: rgba(255,255,255,0.42); }
  .nb-player {
    width: 100%; min-height: 76px; display: grid; grid-template-columns: 34px minmax(0, 1fr); align-items: center;
    gap: 9px; position: relative; overflow: hidden; padding: 10px; text-align: left; color: var(--ink);
    border: 1px solid rgba(32,35,31,.35); border-radius: 5px; background: rgba(244,241,232,.68); cursor: pointer;
    transition: background .15s ease, border-color .15s ease;
  }
  .nb-player:hover { background: rgba(228,199,91,.3); border-color: var(--accent); }
  .nb-player-play {
    position: relative; z-index: 1; display: grid; place-items: center; width: 32px; height: 32px; padding-left: 2px;
    border-radius: 50%; background: var(--accent); color: white; font-size: 11px; box-shadow: 2px 2px 0 rgba(32,35,31,.3);
  }
  .nb-player-copy { position: relative; z-index: 1; min-width: 0; display: flex; flex-direction: column; }
  .nb-player-copy strong { overflow: hidden; text-overflow: ellipsis; white-space: nowrap; font-family: var(--font-display); font-size: 13px; }
  .nb-player-copy > span { margin-top: 2px; font-size: 10px; color: #666b64; }
  .nb-wave {
    position: absolute; inset: auto 8px 8px 54px; height: 18px; opacity: .18;
    background: repeating-linear-gradient(90deg, var(--accent) 0 2px, transparent 2px 5px);
    clip-path: polygon(0 45%, 5% 20%, 10% 55%, 15% 5%, 20% 70%, 25% 25%, 30% 58%, 35% 10%, 40% 80%, 45% 35%, 50% 65%, 55% 15%, 60% 75%, 65% 30%, 70% 60%, 75% 10%, 80% 70%, 85% 25%, 90% 55%, 95% 15%, 100% 48%, 100% 100%, 0 100%);
  }
  .nb-tune-links { font-size: 11px; color: #6a6359; margin-top: 5px; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
  .nb-tune-links a { color: #6a6359; text-decoration: none; }
  .nb-tune-links a:hover { color: var(--accent); text-decoration: underline; }

  .nb-weather { padding: 18px 20px 22px; font-family: var(--font-sans); }
  .nb-date { font-size: 13.5px; color: #6a6359; }
  .nb-time { font-family: var(--font-display); font-size: 30px; font-weight: 700; color: #221f1b; letter-spacing: -0.01em; margin: 2px 0 14px; }
  .nb-weather-row { display: flex; align-items: flex-end; justify-content: space-between; }
  .nb-loc { font-size: 13.5px; color: #6a6359; }
  .nb-temp { font-family: var(--font-display); font-size: 26px; font-weight: 700; color: var(--accent); }
  .nb-cond { font-size: 12.5px; color: #6a6359; margin-top: 2px; }
  .nb-sun { font-size: 13px; font-weight: 600; color: #d88a2c; }
</style>
