---
// Nested-loop motif — concentric ∩ "racetrack" loops (rounded dome on top, open
// at the bottom), an homage to Stereolab's "Dots and Loops" / Roni Size "New
// Forms" early-2000s vector art. Constant gap between loops (each is the previous
// offset outward by `step`), so the lines read as one parallel, hypnotic field.
// Designed to sit large + dimmed as a background watermark (see index hero).
interface Props {
  color?: string;
  opacity?: number;
  count?: number;
  strokeWidth?: number;
}
const { color = 'var(--accent)', opacity = 0.5, count = 16, strokeWidth = 2.5 } = Astro.props;

const cx = 160;
const yBot = 240;
const L = 40;          // straight side length (shared by every loop)
const shoulder = yBot - L;
const h0 = 10;         // innermost half-width
const step = 9;        // constant gap between loops
const loops = Array.from({ length: count }, (_, i) => h0 + i * step);
---

<svg viewBox="0 0 320 240" width="100%" style="display:block" aria-hidden="true" preserveAspectRatio="xMidYMax meet">
  <g fill="none" stroke={color} stroke-width={strokeWidth} stroke-linecap="round" opacity={opacity}>
    {
      loops.map((h) => (
        <path d={`M ${cx - h} ${yBot} L ${cx - h} ${shoulder} A ${h} ${h} 0 0 1 ${cx + h} ${shoulder} L ${cx + h} ${yBot}`} />
      ))
    }
  </g>
</svg>
