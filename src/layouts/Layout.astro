---
import '../styles/global.css';
import NavBox from '../components/NavBox.astro';
import BackgroundShader from '../components/BackgroundShader.astro';
import { ClientRouter } from 'astro:transitions';
import logoAsset from '../assets/logo.jpg';

interface Props {
  title?: string;
  description?: string;
  /** Open Graph image — absolute URL, or site-relative path (resolved to absolute at build) */
  ogImage?: string;
}

const {
  title = 'saman shaiza',
  description = 'my personal website where i share my work, interests, and whatever else ^_^',
  ogImage = logoAsset.src,
} = Astro.props;

const fullTitle = title === 'saman shaiza' ? title : `${title} — saman shaiza`;
// Astro.site is set in astro.config; canonical falls back gracefully in dev.
const canonical = Astro.site ? new URL(Astro.url.pathname, Astro.site).href : Astro.url.pathname;
// og:image must be an absolute URL for social scrapers.
const ogImageUrl = Astro.site && !ogImage.startsWith('http')
  ? new URL(ogImage.startsWith('/') ? ogImage : `/${ogImage}`, Astro.site).href
  : ogImage;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="preload" href="/fonts/PPWriter-Regular.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/HankenGrotesk-VariableFont_wght.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32.png" />
    <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16.png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="canonical" href={canonical} />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    {/* OpenGraph — the 2024 site had none (SEO 3/10) */}
    <meta property="og:type" content="website" />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImageUrl} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="generator" content={Astro.generator} />
    {/* SPA-style navigation: keeps the persisted NavBox mounted (transition:persist)
        and swaps only the main column — like the 2024 RootLayout + <Outlet>. */}
    <ClientRouter />
    {/* Hide [data-animate] before paint — but only when motion is allowed and
        JS runs, so no-JS / reduced-motion users never get stuck-hidden content. */}
    <script is:inline>
      if (!window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
        document.documentElement.classList.add('anim-ready');
      }
    </script>
  </head>
  <body>
    <BackgroundShader />
    <a href="#main" class="sr-only focus:not-sr-only focus:absolute focus:top-2 focus:left-2 focus:z-50 focus:rounded-md focus:bg-primary focus:px-3 focus:py-2 focus:text-primary-foreground">
      Skip to content
    </a>

    <div class="page">
      <div class="shell">
        <main id="main">
          <slot />
        </main>
        <NavBox />
      </div>

      <footer class="site-footer">
        <p class="under-construction">&lt;website is under construction&gt;</p>
        <p>
          <span>© {new Date().getFullYear()} Saman Shaiza.</span>
          <span class="handle-pulse">@samanshaiza on everything</span>
        </p>
      </footer>
    </div>

    <style>
      .page {
        position: relative;
        z-index: 1;
        max-width: 1140px;
        margin: 0 auto;
        padding: 42px 28px 30px;
      }
      .shell {
        display: grid;
        grid-template-columns: minmax(0, 1fr) 330px;
        gap: 22px;
        align-items: start;
      }
      /* min-width:0 lets the content column shrink below its content's
         min-content width — without it a wide <pre> blows the grid track out
         past the viewport on mobile (horizontal overflow). */
      #main { min-width: 0; }
      /* Sidebar stacks below content on narrow screens. minmax(0,1fr) (NOT a
         bare 1fr, which is minmax(auto,1fr)) keeps the single column capped to
         the viewport so code blocks scroll inside their box instead of overflowing. */
      @media (max-width: 900px) {
        .shell { grid-template-columns: minmax(0, 1fr); }
      }
      @media (max-width: 600px) {
        .page { padding: 18px 14px; }
      }

      .site-footer {
        margin-top: 24px;
        padding: 0 4px;
        display: flex;
        flex-wrap: wrap;
        align-items: center;
        justify-content: space-between;
        gap: 8px;
        font-size: 12px;
        color: #6a6359;
      }
      .site-footer .under-construction { font-size: 12px; }
      .site-footer .handle-pulse { margin-left: 8px; }
    </style>

    <script>
      import Lenis from 'lenis';
      import { animate } from 'animejs';
      const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

      // Reveal [data-animate] elements with a staggered anime.js fade + rise
      // as they scroll into view. Re-run per page (initial load + each
      // view-transition swap); the previous page's wiring is torn down first.
      // Self-heals (drops back to plain visible content) if it ever throws.
      let disposeEntrances: (() => void) | null = null;

      function runEntrances() {
        if (reduce) return;
        disposeEntrances?.();           // tear down the previous page's wiring
        disposeEntrances = null;

        const els = [...document.querySelectorAll<HTMLElement>('[data-animate]')];
        if (!els.length) return;

        try {
          const pending = new Set<Element>(els);
          let io: IntersectionObserver;

          // i < 0 → instant (element already off-screen above the fold on
          // load); i >= 0 → staggered entrance for a batch arriving together.
          const settle = (el: Element, i = -1) => {
            if (!pending.has(el)) return;
            pending.delete(el);
            io.unobserve(el);
            if (i < 0) {
              animate(el, { opacity: 1, translateY: 0, duration: 0 });
            } else {
              animate(el, {
                opacity: [0, 1],
                translateY: [12, 0],
                duration: 600,
                delay: i * 70,   // subtle cascade for a batch entering together
                ease: 'out(3)',
              });
            }
          };

          io = new IntersectionObserver((entries) => {
            entries.forEach((e) => {
              if (!e.isIntersecting && e.boundingClientRect.top < 0) settle(e.target);
            });
            entries
              .filter((e) => e.isIntersecting && pending.has(e.target))
              .sort((a, b) =>
                a.target.compareDocumentPosition(b.target) & Node.DOCUMENT_POSITION_FOLLOWING ? -1 : 1
              )
              .forEach((entry, i) => settle(entry.target, i));
          }, { threshold: 0, rootMargin: '0px 0px -6% 0px' });

          els.forEach((el) => io.observe(el));

          let queued = false;
          const sweep = () => {
            queued = false;
            pending.forEach((el) => {
              if (el.getBoundingClientRect().top < 0) settle(el);
            });
            if (!pending.size) teardown();
          };
          const onScroll = () => {
            if (!queued) { queued = true; requestAnimationFrame(sweep); }
          };
          const teardown = () => {
            io.disconnect();
            window.removeEventListener('scroll', onScroll);
          };

          window.addEventListener('scroll', onScroll, { passive: true });
          requestAnimationFrame(() => requestAnimationFrame(sweep));

          disposeEntrances = teardown;
        } catch (err) {
          document.documentElement.classList.remove('anim-ready');
          console.error('entrance animation failed', err);
        }
      }

      // One-time setup. The hoisted script re-executes on every swap, so guard
      // shared listeners; only the per-page entrance observer repeats.
      if (!(window as any).__siteInit) {
        (window as any).__siteInit = true;

        if (!reduce) {
          const lenis = new Lenis({ duration: 1.0, smoothWheel: true });
          const raf = (time: number) => { lenis.raf(time); requestAnimationFrame(raf); };
          requestAnimationFrame(raf);
        }

        // Astro preserves scroll for history navigation, which is useful. A
        // newly clicked internal route should open at its top, especially on
        // mobile where the persisted nav sits below the current page.
        document.addEventListener('click', (event) => {
          const target = event.target;
          const link = target instanceof Element ? target.closest<HTMLAnchorElement>('a[href]') : null;
          if (!link) return;
          const next = new URL(link.href, location.href);
          if (next.origin === location.origin && next.pathname !== location.pathname && !next.hash) {
            (window as any).__resetScrollAfterSwap = true;
          }
        });

        runEntrances();                                              // initial load
        document.addEventListener('astro:after-swap', () => {
          if ((window as any).__resetScrollAfterSwap) {
            (window as any).__resetScrollAfterSwap = false;
            window.scrollTo(0, 0);
          }
          runEntrances();                                            // each navigation
        });
      }
    </script>
  </body>
</html>
