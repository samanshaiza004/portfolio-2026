---
import '../styles/global.css';
import NavBox from '../components/NavBox.astro';
import { ClientRouter } from 'astro:transitions';

interface Props {
  title?: string;
  description?: string;
  /** Open Graph image, absolute or site-relative */
  ogImage?: string;
}

const {
  title = 'saman shaiza',
  description = 'my personal website where i share my work, interests, and whatever else ^_^',
  ogImage = '/logo.jpg',
} = Astro.props;

const fullTitle = title === 'saman shaiza' ? title : `${title} — saman shaiza`;
// Astro.site is set in astro.config; canonical falls back gracefully in dev.
const canonical = Astro.site ? new URL(Astro.url.pathname, Astro.site).href : Astro.url.pathname;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32.png" />
    <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16.png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="canonical" href={canonical} />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    {/* OpenGraph — the 2024 site had none (SEO 3/10) */}
    <meta property="og:type" content="website" />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImage} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="generator" content={Astro.generator} />
    {/* SPA-style navigation: keeps the persisted NavBox mounted (transition:persist)
        and swaps only the main column — like the 2024 RootLayout + <Outlet>. */}
    <ClientRouter />
    {/* Hide [data-animate] before paint — but only when motion is allowed and
        JS runs, so no-JS / reduced-motion users never get stuck-hidden content. */}
    <script is:inline>
      if (!window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
        document.documentElement.classList.add('anim-ready');
      }
    </script>
  </head>
  <body>
    <a href="#main" class="sr-only focus:not-sr-only focus:absolute focus:top-2 focus:left-2 focus:z-50 focus:rounded-md focus:bg-primary focus:px-3 focus:py-2 focus:text-primary-foreground">
      Skip to content
    </a>

    <div class="page">
      <div class="shell">
        <main id="main">
          <slot />
        </main>
        <NavBox />
      </div>

      <footer class="site-footer">
        <p class="under-construction">&lt;website is under construction&gt;</p>
        <p>
          <span>© {new Date().getFullYear()} Saman Shaiza.</span>
          <span class="handle-pulse">@samanshaiza on everything</span>
        </p>
      </footer>
    </div>

    <style>
      .page {
        max-width: 1140px;
        margin: 0 auto;
        padding: 34px 28px;
      }
      .shell {
        display: grid;
        grid-template-columns: minmax(0, 1fr) 330px;
        gap: 22px;
        align-items: start;
      }
      /* Sidebar stacks below content on narrow screens. */
      @media (max-width: 900px) {
        .shell { grid-template-columns: 1fr; }
      }

      .site-footer {
        margin-top: 24px;
        display: flex;
        flex-wrap: wrap;
        align-items: center;
        justify-content: space-between;
        gap: 8px;
        font-size: 12px;
        color: #9a9389;
      }
      .site-footer .under-construction { font-size: 12px; }
      .site-footer .handle-pulse { margin-left: 8px; }
    </style>

    <script>
      import Lenis from 'lenis';
      import { animate } from 'animejs';

      const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

      // Reveal [data-animate] elements. An IntersectionObserver staggers each
      // batch that enters the viewport (above-the-fold on load + scroll-in),
      // cascading top-to-bottom. A throttled scroll/raf sweep is the safety net
      // for jumps IO can't observe (the intersection ratio going 0→0 when an
      // element is teleported past — scroll restored on reload, a fast scrollbar
      // drag): it instantly reveals anything already scrolled above the fold.
      // Re-run per page (initial load + each view-transition swap); the previous
      // page's observer + listener are torn down first. Self-heals if it throws.
      let disposeEntrances: (() => void) | null = null;

      function runEntrances() {
        if (reduce) return;
        disposeEntrances?.();           // tear down the previous page's wiring
        disposeEntrances = null;

        const els = [...document.querySelectorAll<HTMLElement>('[data-animate]')];
        if (!els.length) return;

        try {
          const pending = new Set<Element>(els);
          let io: IntersectionObserver;

          // i < 0 → instant (element already off-screen above the fold);
          // i >= 0 → staggered entrance for a batch arriving together.
          const settle = (el: Element, i = -1) => {
            if (!pending.has(el)) return;
            pending.delete(el);
            io.unobserve(el);
            if (i < 0) {
              animate(el, { opacity: 1, translateY: 0, duration: 0 });
            } else {
              animate(el, {
                opacity: [0, 1],
                translateY: [16, 0],
                duration: 650,
                delay: i * 80,   // subtle stagger for a batch entering together
                ease: 'out(3)',
              });
            }
          };

          io = new IntersectionObserver((entries) => {
            // anything reported above the fold gets revealed instantly…
            entries.forEach((e) => {
              if (!e.isIntersecting && e.boundingClientRect.top < 0) settle(e.target);
            });
            // …and the batch entering the viewport cascades in DOM order.
            entries
              .filter((e) => e.isIntersecting && pending.has(e.target))
              .sort((a, b) =>
                a.target.compareDocumentPosition(b.target) & Node.DOCUMENT_POSITION_FOLLOWING ? -1 : 1
              )
              .forEach((entry, i) => settle(entry.target, i));
          }, { threshold: 0.12 });

          els.forEach((el) => io.observe(el));

          let queued = false;
          const sweep = () => {
            queued = false;
            pending.forEach((el) => {
              if (el.getBoundingClientRect().top < 0) settle(el);
            });
            if (!pending.size) teardown();
          };
          const onScroll = () => {
            if (!queued) { queued = true; requestAnimationFrame(sweep); }
          };
          const teardown = () => {
            io.disconnect();
            window.removeEventListener('scroll', onScroll);
          };

          window.addEventListener('scroll', onScroll, { passive: true });
          // run once after any scroll position the browser restores post-load
          requestAnimationFrame(() => requestAnimationFrame(sweep));

          disposeEntrances = teardown;
        } catch (err) {
          document.documentElement.classList.remove('anim-ready');
          console.error('entrance animation failed', err);
        }
      }

      // One-time setup. The hoisted script re-executes on every swap, so guard
      // the Lenis instance + listener; only the per-page entrances repeat.
      if (!(window as any).__siteInit) {
        (window as any).__siteInit = true;

        if (!reduce) {
          // Lenis smooth scroll — duration 1.0 (the 2024 site's ~1.4 felt sluggish).
          const lenis = new Lenis({ duration: 1.0, smoothWheel: true });
          const raf = (time: number) => { lenis.raf(time); requestAnimationFrame(raf); };
          requestAnimationFrame(raf);
        }

        runEntrances();                                              // initial load
        document.addEventListener('astro:after-swap', runEntrances); // each navigation
      }
    </script>
  </body>
</html>
